 	[ -f "$audio_topology" ] && [ ! -L "$audio_topology" ] && \
 		[ "$(sha256sum "$audio_topology" | cut -d' ' -f1)" = "$audio_topology_sha256" ] || {
 		echo "error: AudioReach topology identity mismatch: $audio_topology" >&2
